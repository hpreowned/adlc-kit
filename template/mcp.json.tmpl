{
  "mcpServers": {
    "serena": {
      "type": "local",
      "command": "uvx",
      "args": [
        "--from", "git+{{serena_repo}}@{{serena_commit}}",
        "serena", "start-mcp-server",
        "--context", "{{context_path}}",
        "--agent-interface", "tools",
        {{project_args}}
        "--enable-web-dashboard", "false",
        "--enable-gui-log-window", "false"
      ],
      "tools": {{serena_tools_json}}
    }
  }
}
