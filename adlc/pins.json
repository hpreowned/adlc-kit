{
  "_comment": "Kit-owned pins for everything that is not a Python dependency (those live in uv.lock). PINS.md is generated from both. Bump via Renovate, never by hand in a consuming repo.",
  "copilot_cli": {
    "version": "1.0.105",
    "install": "brew install --cask copilot-cli | npm i -g @github/copilot@1.0.105"
  },
  "graphify": {
    "package": "graphifyy[leiden]",
    "version": "0.9.97",
    "wheel_sha256": "eb24dd7f93293753c001ca36e7304e0b52e86fe4124c2f531dcdb3d64865e01a"
  },
  "serena": {
    "repo": "https://github.com/oraios/serena",
    "commit": "ede329aaf0c824bea75455a2926f01420d7aa620",
    "license": "GPL-3.0-or-later (app) / MIT (SolidLSP) \u2014 see DECISION_ADR.md",
    "context": "copilot-cli",
    "tools": [
      "find_symbol",
      "find_referencing_symbols",
      "get_symbols_overview",
      "find_implementations",
      "get_diagnostics_for_file",
      "replace_symbol_body",
      "insert_after_symbol",
      "insert_before_symbol",
      "read_memory",
      "list_memories"
    ]
  },
  "language_servers": {
    "_comment": "Pinned transitively by the Serena commit (solidlsp downloads exactly these); pre-warm on a machine or CI runner with `serena download-ls-dependencies python typescript java csharp`.",
    "python": {
      "name": "pyright",
      "version": "1.1.403",
      "source": "solidlsp/language_servers/pyright_server.py"
    },
    "typescript": {
      "name": "typescript-language-server",
      "version": "5.1.3",
      "typescript": "5.9.3",
      "source": "solidlsp/language_servers/typescript_language_server.py"
    },
    "java": {
      "name": "eclipse-jdtls (VSIX, sha256-pinned)",
      "version": "see solidlsp/language_servers/eclipse_jdtls.py",
      "source": "solidlsp/language_servers/eclipse_jdtls.py"
    },
    "csharp": {
      "name": "roslyn-language-server",
      "version": "5.5.0-2.26078.4",
      "source": "solidlsp/language_servers/csharp_language_server.py"
    }
  },
  "python": "3.12",
  "kit": {
    "repo": "kestrel-freight/adlc-kit",
    "ref": "v0.1.3"
  }
}
