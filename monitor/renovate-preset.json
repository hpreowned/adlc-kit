{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "ADLC kit preset: tool bumps are PRs with required review and `adlc-regress` as the required check. Nobody edits a pin by hand.",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["pep621", "pip_requirements", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Serena commit pin in .mcp.json",
      "fileMatch": ["^\\.mcp\\.json$"],
      "matchStrings": ["git\\+https://github.com/oraios/serena@(?<currentDigest>[a-f0-9]{40})"],
      "depNameTemplate": "oraios/serena",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "kit ref used by the consuming repo's workflow",
      "fileMatch": ["^\\.github/workflows/adlc\\.yml$"],
      "matchStrings": ["adlc-kit/\\.github/workflows/[a-z-]+\\.yml@(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "kestrel-freight/adlc-kit",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {"matchPackageNames": ["graphifyy"], "groupName": "adlc: graphify", "labels": ["adlc", "tool-bump"], "reviewersFromCodeOwners": true},
    {"matchPackageNames": ["oraios/serena"], "groupName": "adlc: serena", "labels": ["adlc", "tool-bump"], "reviewersFromCodeOwners": true},
    {"matchPackageNames": ["kestrel-freight/adlc-kit"], "groupName": "adlc: kit", "labels": ["adlc", "kit-bump"], "reviewersFromCodeOwners": true},
    {"matchPackageNames": ["graphifyy", "oraios/serena", "kestrel-freight/adlc-kit"], "automerge": false, "schedule": ["before 6am on monday"]}
  ],
  "prBodyNotes": ["A tool bump re-runs `adlc regress` (required check). Compare the new trend row with the pilot median before merging; see monitor/RUNBOOK.md."]
}
